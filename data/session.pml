# PyMOL Visualization Script generated by AutoDock Studio
reinitialize
load complex_pose_1.pdb, complex
hide everything, complex

# Protein Cartoon
show cartoon, complex and not resn LIG
color marine, complex and not resn LIG

# Ligand Sticks
show sticks, complex and resn LIG
color magenta, complex and resn LIG
util.cnc complex and resn LIG

# Pocket Residues
select pocket, complex and not resn LIG and resi 719+831+751+767+738+772+694+768+820+721+742+769+770+766+830+702
show sticks, pocket
color gray80, pocket
util.cnc pocket

# Polar contacts (Hydrogen bonds)
distance hbonds, complex and resn LIG, pocket, 3.5, mode=2
color yellow, hbonds

# View settings
set dash_width, 2.5
set dash_gap, 0.25
bg_color white
zoom complex and resn LIG, 6
